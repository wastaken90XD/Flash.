+static SDL_JoystickDriver SDL_Winebox_JoystickDriver;
+
+static int SDL_WineboxJoystickInit(void) { return 0; }
+static int SDL_WineboxJoystickGetCount(void) { return SDL_winebox_joystick_enabled ? 1 : 0; }
+static void SDL_WineboxJoystickDetect(void) { }
+static const char *SDL_WineboxJoystickGetDeviceName(int device_index)
+{
+    return (device_index == 0 && SDL_winebox_joystick_enabled) ? "Winebox Virtual Controller" : NULL;
