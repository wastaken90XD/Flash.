+extern "C" int winebox_boxedwine_queue_input_event(const SDL_Event* event) {
+    if (!event) return 0;
+    std::lock_guard<std::mutex> lock(wineboxInputQueueMutex);
+    if (wineboxInputQueue.size() >= wineboxInputQueueLimit) return 0;
+    wineboxInputQueue.push_back(*event);
