+static int SDL_WineboxJoystickGetDevicePlayerIndex(int device_index) { return device_index == 0 ? 0 : -1; }
+static void SDL_WineboxJoystickSetDevicePlayerIndex(int device_index, int player_index) { (void)device_index; (void)player_index; }
+static SDL_JoystickGUID SDL_WineboxJoystickGetDeviceGUID(int device_index)
+{
+    SDL_JoystickGUID guid;
+    (void)device_index;
+    SDL_memset(&guid, 0, sizeof(guid));
+    SDL_memcpy(guid.data, "WINEBOXVIRTUAL", 14);
+    return guid;
+}
+static SDL_JoystickID SDL_WineboxJoystickGetDeviceInstanceID(int device_index)
+{
+    return (device_index == 0 && SDL_winebox_joystick_enabled) ? SDL_winebox_joystick_instance : -1;
+}
+static int SDL_WineboxJoystickOpen(SDL_Joystick *joystick, int device_index)
+{
+    if (device_index != 0 || !SDL_winebox_joystick_enabled) return SDL_SetError("Winebox virtual joystick is disabled");
+    joystick->naxes = 4;
+    joystick->nhats = 1;
+    joystick->nballs = 0;
+    joystick->nbuttons = 8;
+    joystick->driver = &SDL_Winebox_JoystickDriver;
+    return 0;
+}
+static int SDL_WineboxJoystickRumble(SDL_Joystick *joystick, Uint16 low, Uint16 high)
+{ (void)joystick; (void)low; (void)high; return SDL_Unsupported(); }
+static void SDL_WineboxJoystickUpdate(SDL_Joystick *joystick)
+{
+    int i;
+    if (!joystick || !joystick->attached) return;
+    for (i = 0; i < 4; ++i) SDL_PrivateJoystickAxis(joystick, (Uint8)i, SDL_winebox_joystick_axes[i]);
+    for (i = 0; i < 8; ++i) SDL_PrivateJoystickButton(joystick, (Uint8)i, SDL_winebox_joystick_buttons[i]);
+    SDL_PrivateJoystickHat(joystick, 0, SDL_winebox_joystick_hat);
+}
+static void SDL_WineboxJoystickClose(SDL_Joystick *joystick) { (void)joystick; }
+static void SDL_WineboxJoystickQuit(void) { }
+static SDL_JoystickDriver SDL_Winebox_JoystickDriver = {
+    SDL_WineboxJoystickInit, SDL_WineboxJoystickGetCount, SDL_WineboxJoystickDetect,
+    SDL_WineboxJoystickGetDeviceName, SDL_WineboxJoystickGetDevicePlayerIndex,
+    SDL_WineboxJoystickSetDevicePlayerIndex, SDL_WineboxJoystickGetDeviceGUID,
+    SDL_WineboxJoystickGetDeviceInstanceID, SDL_WineboxJoystickOpen,
+    SDL_WineboxJoystickRumble, SDL_WineboxJoystickUpdate, SDL_WineboxJoystickClose,
+    SDL_WineboxJoystickQuit
+};
+
+void SDL_WineboxJoystickSetEnabled(SDL_bool enabled)
+{
+    const SDL_bool was_enabled = SDL_winebox_joystick_enabled;
+    SDL_LockJoysticks();
+    SDL_winebox_joystick_enabled = enabled ? SDL_TRUE : SDL_FALSE;
+    SDL_UnlockJoysticks();
+    if (was_enabled != SDL_winebox_joystick_enabled) {
+        if (SDL_winebox_joystick_enabled) SDL_PrivateJoystickAdded(SDL_winebox_joystick_instance);
+        else SDL_PrivateJoystickRemoved(SDL_winebox_joystick_instance);
+    }
+}
+void SDL_WineboxJoystickSetAxis(int axis, Sint16 value)
+{
+    if (axis >= 0 && axis < 4) {
+        SDL_LockJoysticks();
+        SDL_winebox_joystick_axes[axis] = value;
+        SDL_UnlockJoysticks();
+    }
+}
+void SDL_WineboxJoystickSetButton(int button, Uint8 value)
+{
+    if (button >= 0 && button < 8) {
+        SDL_LockJoysticks();
+        SDL_winebox_joystick_buttons[button] = value ? SDL_PRESSED : SDL_RELEASED;
+        SDL_UnlockJoysticks();
+    }
+}
+void SDL_WineboxJoystickSetHat(Uint8 value)
+{
+    SDL_LockJoysticks();
+    SDL_winebox_joystick_hat = value;
+    SDL_UnlockJoysticks();
+}
